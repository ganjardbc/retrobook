// Skema inti Fase 1 dan 2 (docs/03-erd.md). Tabel admin dan Fase 3 menyusul lewat migrasi terpisah.
// Belum ada: notifications.announcement_id (T-48), posts.group_id (Fase 3).
// CHECK constraint (likes, friendships) ditulis manual di SQL migrasi karena Prisma belum mendukungnya.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum Privacy {
  PUBLIC
  FRIENDS
  ONLY_ME
}

enum FriendStatus {
  PENDING
  ACCEPTED
}

enum NotifType {
  LIKE
  COMMENT
  FRIEND_REQUEST
  FRIEND_ACCEPT
  POKE
  TAG
  WALL_POST
  ANNOUNCEMENT
}

enum ReportTargetType {
  POST
  COMMENT
  USER
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique @db.VarChar(191)
  username     String     @unique @db.VarChar(30)
  displayName  String     @map("display_name") @db.VarChar(80)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  isBot        Boolean    @default(false) @map("is_bot")
  bio          String?    @db.Text
  avatarUrl    String?    @map("avatar_url") @db.VarChar(255)
  coverUrl     String?    @map("cover_url") @db.VarChar(255)
  birthday     DateTime?  @db.Date
  hometown     String?    @db.VarChar(80)
  currentCity  String?    @map("current_city") @db.VarChar(80)
  workplace    String?    @db.VarChar(120)
  school       String?    @db.VarChar(120)
  lastSeenAt   DateTime?  @map("last_seen_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  deletedAt    DateTime?  @map("deleted_at")

  refreshTokens        RefreshToken[]
  posts                Post[]         @relation("PostAuthor")
  wallPosts            Post[]         @relation("WallOwner")
  comments             Comment[]
  likes                Like[]
  postTags             PostTag[]
  friendshipsSent      Friendship[]   @relation("FriendRequester")
  friendshipsReceived  Friendship[]   @relation("FriendAddressee")
  pokesSent            Poke[]         @relation("PokeFrom")
  pokesReceived        Poke[]         @relation("PokeTo")
  messagesSent         Message[]      @relation("MessageSender")
  messagesReceived     Message[]      @relation("MessageReceiver")
  notifications        Notification[] @relation("NotifRecipient")
  notificationsAsActor Notification[] @relation("NotifActor")
  blocksMade           Block[]        @relation("Blocker")
  blocksReceived       Block[]        @relation("Blocked")
  reportsMade          Report[]       @relation("ReportReporter")
  reportsHandled       Report[]       @relation("ReportHandler")
  auditLogs            AuditLog[]
  settingsUpdated      Setting[]      @relation("SettingUpdater")
  announcementsCreated Announcement[] @relation("AnnouncementCreator")
  blockedWordsCreated  BlockedWord[]  @relation("BlockedWordCreator")
  botProfile           BotProfile?
  sponsoredCreated     Sponsored[]    @relation("SponsoredCreator")
  passwordResetTokens  PasswordResetToken[]

  @@index([status, createdAt])
  @@index([username])
  @@fulltext([displayName])
  @@map("users")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Post {
  id           Int       @id @default(autoincrement())
  authorId     Int       @map("author_id")
  wallOwnerId  Int?      @map("wall_owner_id")
  sharedFromId Int?      @map("shared_from_id")
  content      String    @db.Text // boleh string kosong bila ada image_url; MySQL TEXT tanpa DEFAULT, service wajib mengisi
  imageUrl     String?   @map("image_url") @db.VarChar(255)
  feeling      String?   @db.VarChar(40)
  privacy      Privacy   @default(FRIENDS)
  hidden       Boolean   @default(false)
  flagged      Boolean   @default(false)
  editedAt     DateTime? @map("edited_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  author        User           @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  wallOwner     User?          @relation("WallOwner", fields: [wallOwnerId], references: [id], onDelete: Restrict)
  sharedFrom    Post?          @relation("PostShare", fields: [sharedFromId], references: [id], onDelete: SetNull)
  shares        Post[]         @relation("PostShare")
  comments      Comment[]
  likes         Like[]
  tags          PostTag[]
  hashtags      PostHashtag[]
  notifications Notification[]

  @@index([authorId, createdAt])
  @@index([wallOwnerId, createdAt])
  @@index([createdAt])
  @@map("posts")
}

model Comment {
  id        Int       @id @default(autoincrement())
  postId    Int       @map("post_id")
  authorId  Int       @map("author_id")
  content   String    @db.Text
  imageUrl  String?   @map("image_url") @db.VarChar(255)
  hidden    Boolean   @default(false)
  flagged   Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  likes         Like[]
  notifications Notification[]

  @@index([postId, createdAt])
  @@map("comments")
}

// Tepat satu dari postId atau commentId terisi (CHECK di SQL migrasi).
model Like {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  postId    Int?     @map("post_id")
  commentId Int?     @map("comment_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@index([postId])
  @@index([commentId])
  @@map("likes")
}

model PostTag {
  postId Int @map("post_id")
  userId Int @map("user_id")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([postId, userId])
  @@map("post_tags")
}

model Hashtag {
  id        Int      @id @default(autoincrement())
  tag       String   @unique @db.VarChar(50)
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  posts PostHashtag[]

  @@map("hashtags")
}

model PostHashtag {
  postId    Int      @map("post_id")
  hashtagId Int      @map("hashtag_id")
  createdAt DateTime @default(now()) @map("created_at")

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId])
  @@index([hashtagId, createdAt])
  @@map("post_hashtags")
}

// Satu baris per pasangan (BR-01): service mengisi pairLowId = min, pairHighId = max.
// CHECK requester_id <> addressee_id ada di SQL migrasi.
model Friendship {
  id          Int          @id @default(autoincrement())
  requesterId Int          @map("requester_id")
  addresseeId Int          @map("addressee_id")
  pairLowId   Int          @map("pair_low_id")
  pairHighId  Int          @map("pair_high_id")
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at")
  respondedAt DateTime?    @map("responded_at")

  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  addressee User @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([pairLowId, pairHighId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("friendships")
}

model Block {
  id        Int      @id @default(autoincrement())
  blockerId Int      @map("blocker_id")
  blockedId Int      @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Restrict)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Restrict)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model Poke {
  id         Int       @id @default(autoincrement())
  fromUserId Int       @map("from_user_id")
  toUserId   Int       @map("to_user_id")
  seenAt     DateTime? @map("seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  from User @relation("PokeFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  to   User @relation("PokeTo", fields: [toUserId], references: [id], onDelete: Restrict)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, seenAt])
  @@map("pokes")
}

model Message {
  id         Int       @id @default(autoincrement())
  senderId   Int       @map("sender_id")
  receiverId Int       @map("receiver_id")
  content    String    @db.Text
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  deletedAt  DateTime? @map("deleted_at")

  sender   User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  receiver User @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Restrict)

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, readAt])
  @@map("messages")
}

model Notification {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  actorId        Int?      @map("actor_id")
  type           NotifType
  postId         Int?      @map("post_id")
  commentId      Int?      @map("comment_id")
  announcementId Int?      @map("announcement_id")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user         User          @relation("NotifRecipient", fields: [userId], references: [id], onDelete: Restrict)
  actor        User?         @relation("NotifActor", fields: [actorId], references: [id], onDelete: SetNull)
  post         Post?         @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment      Comment?      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([announcementId])
  @@map("notifications")
}

model Report {
  id         Int              @id @default(autoincrement())
  reporterId Int              @map("reporter_id")
  targetType ReportTargetType @map("target_type")
  targetId   Int              @map("target_id")
  reason     ReportReason
  note       String?          @db.Text
  status     ReportStatus     @default(PENDING)
  handledBy  Int?             @map("handled_by")
  handledAt  DateTime?        @map("handled_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  reporter User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  handler  User? @relation("ReportHandler", fields: [handledBy], references: [id], onDelete: Restrict)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  adminId    Int      @map("admin_id")
  action     String   @db.VarChar(60)
  targetType String?  @map("target_type") @db.VarChar(30)
  targetId   Int?     @map("target_id")
  detail     Json?
  ip         String?  @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  admin User @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Setting {
  key       String   @id @db.VarChar(60)
  value     Json
  updatedBy Int?     @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  updater User? @relation("SettingUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("settings")
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(120)
  body      String   @db.Text
  createdBy Int      @map("created_by")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  creator       User           @relation("AnnouncementCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@map("announcements")
}

model BlockedWord {
  id        Int      @id @default(autoincrement())
  word      String   @unique @db.VarChar(60)
  createdBy Int      @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  creator User @relation("BlockedWordCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@map("blocked_words")
}

model BotProfile {
  userId      Int       @id @map("user_id")
  persona     String    @db.Text
  postsPerDay Int       @default(2) @map("posts_per_day")
  active      Boolean   @default(true)
  lastPostAt  DateTime? @map("last_post_at")
  lastTickAt  DateTime? @map("last_tick_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bot_profiles")
}

model Sponsored {
  id        Int       @id @default(autoincrement())
  title     String    @db.VarChar(120)
  body      String    @db.Text
  imageUrl  String?   @map("image_url") @db.VarChar(255)
  linkUrl   String    @map("link_url") @db.VarChar(255)
  active    Boolean   @default(true)
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  createdBy Int       @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")

  creator User @relation("SponsoredCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([active, startsAt, endsAt])
  @@map("sponsored")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
