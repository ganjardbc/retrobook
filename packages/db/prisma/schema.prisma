// Skema inti Fase 1 dan 2 (docs/03-erd.md). Tabel admin dan Fase 3 menyusul lewat migrasi terpisah.
// Belum ada: notifications.announcement_id (T-48), posts.group_id (Fase 3).
// CHECK constraint (likes, friendships) ditulis manual di SQL migrasi karena Prisma belum mendukungnya.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum Privacy {
  PUBLIC
  FRIENDS
  ONLY_ME
}

enum GroupPrivacy {
  PUBLIC
  CLOSED
}

enum GroupMemberRole {
  MEMBER
  ADMIN
}

enum RsvpStatus {
  GOING
  MAYBE
  DECLINED
}

enum LifeEventKind {
  MOVED
  STARTED_JOB
  GRADUATED
  OTHER
}

enum FriendStatus {
  PENDING
  ACCEPTED
}

enum NotifType {
  LIKE
  COMMENT
  FRIEND_REQUEST
  FRIEND_ACCEPT
  POKE
  TAG
  WALL_POST
  ANNOUNCEMENT
}

enum ReportTargetType {
  POST
  COMMENT
  USER
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

model User {
  id                 String     @id @default(uuid()) @db.Char(36)
  email              String     @unique @db.VarChar(191)
  username           String     @unique @db.VarChar(30)
  displayName        String     @map("display_name") @db.VarChar(80)
  passwordHash       String     @map("password_hash") @db.VarChar(255)
  role               Role       @default(USER)
  status             UserStatus @default(ACTIVE)
  isBot              Boolean    @default(false) @map("is_bot")
  bio                String?    @db.Text
  avatarUrl          String?    @map("avatar_url") @db.VarChar(255)
  coverUrl           String?    @map("cover_url") @db.VarChar(255)
  birthday           DateTime?  @db.Date
  hometown           String?    @db.VarChar(80)
  currentCity        String?    @map("current_city") @db.VarChar(80)
  workplace          String?    @db.VarChar(120)
  school             String?    @db.VarChar(120)
  profileInfoPrivacy Privacy    @default(PUBLIC) @map("profile_info_privacy")
  friendsPrivacy     Privacy    @default(PUBLIC) @map("friends_privacy")
  defaultPostPrivacy Privacy    @default(FRIENDS) @map("default_post_privacy")
  lastSeenAt         DateTime?  @map("last_seen_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  deletedAt          DateTime?  @map("deleted_at")

  refreshTokens        RefreshToken[]
  posts                Post[]               @relation("PostAuthor")
  wallPosts            Post[]               @relation("WallOwner")
  comments             Comment[]
  likes                Like[]
  savedPosts           SavedPost[]
  postTags             PostTag[]
  friendshipsSent      Friendship[]         @relation("FriendRequester")
  friendshipsReceived  Friendship[]         @relation("FriendAddressee")
  pokesSent            Poke[]               @relation("PokeFrom")
  pokesReceived        Poke[]               @relation("PokeTo")
  messagesSent         Message[]            @relation("MessageSender")
  messagesReceived     Message[]            @relation("MessageReceiver")
  conversationStates   ConversationState[]  @relation("ConvStateOwner")
  conversationStatesOf ConversationState[]  @relation("ConvStatePeer")
  notifications        Notification[]       @relation("NotifRecipient")
  notificationsAsActor Notification[]       @relation("NotifActor")
  blocksMade           Block[]              @relation("Blocker")
  blocksReceived       Block[]              @relation("Blocked")
  reportsMade          Report[]             @relation("ReportReporter")
  reportsHandled       Report[]             @relation("ReportHandler")
  auditLogs            AuditLog[]
  settingsUpdated      Setting[]            @relation("SettingUpdater")
  announcementsCreated Announcement[]       @relation("AnnouncementCreator")
  blockedWordsCreated  BlockedWord[]        @relation("BlockedWordCreator")
  botProfile           BotProfile?
  sponsoredCreated     Sponsored[]          @relation("SponsoredCreator")
  passwordResetTokens  PasswordResetToken[]
  albums               Album[]
  photos               Photo[]
  groupsCreated        Group[]              @relation("GroupCreator")
  groupMemberships     GroupMember[]
  eventsCreated        Event[]              @relation("EventCreator")
  eventRsvps           EventRsvp[]
  notes                Note[]               @relation("NoteAuthor")
  lifeEvents           LifeEvent[]

  @@index([status, createdAt])
  @@index([username])
  @@fulltext([displayName])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Post {
  id           String    @id @default(uuid()) @db.Char(36)
  authorId     String    @map("author_id") @db.Char(36)
  wallOwnerId  String?   @map("wall_owner_id") @db.Char(36)
  sharedFromId String?   @map("shared_from_id") @db.Char(36)
  content      String    @db.Text // boleh string kosong bila ada image_url; MySQL TEXT tanpa DEFAULT, service wajib mengisi
  imageUrl     String?   @map("image_url") @db.VarChar(255)
  groupId      String?   @map("group_id") @db.Char(36)
  feeling      String?   @db.VarChar(40)
  privacy      Privacy   @default(FRIENDS)
  hidden       Boolean   @default(false)
  flagged      Boolean   @default(false)
  editedAt     DateTime? @map("edited_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  author        User           @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  wallOwner     User?          @relation("WallOwner", fields: [wallOwnerId], references: [id], onDelete: Restrict)
  sharedFrom    Post?          @relation("PostShare", fields: [sharedFromId], references: [id], onDelete: SetNull)
  shares        Post[]         @relation("PostShare")
  comments      Comment[]
  likes         Like[]
  savedBy       SavedPost[]
  tags          PostTag[]
  hashtags      PostHashtag[]
  group         Group?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([authorId, createdAt])
  @@index([wallOwnerId, createdAt])
  @@index([createdAt])
  @@index([groupId, createdAt])
  @@map("posts")
}

model Comment {
  id        String    @id @default(uuid()) @db.Char(36)
  postId    String    @map("post_id") @db.Char(36)
  authorId  String    @map("author_id") @db.Char(36)
  content   String    @db.Text
  imageUrl  String?   @map("image_url") @db.VarChar(255)
  hidden    Boolean   @default(false)
  flagged   Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  likes         Like[]
  notifications Notification[]

  @@index([postId, createdAt])
  @@map("comments")
}

// Tepat satu dari postId atau commentId terisi (CHECK di SQL migrasi).
model Like {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  postId    String?  @map("post_id") @db.Char(36)
  commentId String?  @map("comment_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@index([postId])
  @@index([commentId])
  @@index([postId, createdAt])
  @@index([commentId, createdAt])
  @@map("likes")
}

model SavedPost {
  userId    String   @map("user_id") @db.Char(36)
  postId    String   @map("post_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, createdAt])
  @@map("saved_posts")
}

model PostTag {
  postId String @map("post_id") @db.Char(36)
  userId String @map("user_id") @db.Char(36)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([postId, userId])
  @@map("post_tags")
}

model Hashtag {
  id        String   @id @default(uuid()) @db.Char(36)
  tag       String   @unique @db.VarChar(50)
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  posts PostHashtag[]

  @@map("hashtags")
}

model PostHashtag {
  postId    String   @map("post_id") @db.Char(36)
  hashtagId String   @map("hashtag_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId])
  @@index([hashtagId, createdAt])
  @@map("post_hashtags")
}

// Satu baris per pasangan (BR-01): service mengisi pairLowId = min, pairHighId = max.
// CHECK requester_id <> addressee_id ada di SQL migrasi.
model Friendship {
  id          String       @id @default(uuid()) @db.Char(36)
  requesterId String       @map("requester_id") @db.Char(36)
  addresseeId String       @map("addressee_id") @db.Char(36)
  pairLowId   String       @map("pair_low_id") @db.Char(36)
  pairHighId  String       @map("pair_high_id") @db.Char(36)
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at")
  respondedAt DateTime?    @map("responded_at")

  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  addressee User @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([pairLowId, pairHighId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@index([addresseeId, status, createdAt])
  @@index([requesterId, status, createdAt])
  @@map("friendships")
}

model Block {
  id        String   @id @default(uuid()) @db.Char(36)
  blockerId String   @map("blocker_id") @db.Char(36)
  blockedId String   @map("blocked_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Restrict)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Restrict)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model Poke {
  id         String    @id @default(uuid()) @db.Char(36)
  fromUserId String    @map("from_user_id") @db.Char(36)
  toUserId   String    @map("to_user_id") @db.Char(36)
  seenAt     DateTime? @map("seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  from User @relation("PokeFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  to   User @relation("PokeTo", fields: [toUserId], references: [id], onDelete: Restrict)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, seenAt])
  @@map("pokes")
}

model Message {
  id         String    @id @default(uuid()) @db.Char(36)
  senderId   String    @map("sender_id") @db.Char(36)
  receiverId String    @map("receiver_id") @db.Char(36)
  content    String    @db.Text
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  deletedAt  DateTime? @map("deleted_at")

  sender   User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  receiver User @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Restrict)

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, readAt])
  @@map("messages")
}

/// Status percakapan per pengguna: Clear chat (cleared_at) dan Hapus sesi (hidden_at) hanya berlaku untuk pemiliknya.
model ConversationState {
  userId    String    @map("user_id") @db.Char(36)
  peerId    String    @map("peer_id") @db.Char(36)
  clearedAt DateTime  @default(now()) @map("cleared_at")
  hiddenAt  DateTime? @map("hidden_at")

  user User @relation("ConvStateOwner", fields: [userId], references: [id], onDelete: Restrict)
  peer User @relation("ConvStatePeer", fields: [peerId], references: [id], onDelete: Restrict)

  @@id([userId, peerId])
  @@index([peerId])
  @@map("conversation_states")
}

model Notification {
  id             String    @id @default(uuid()) @db.Char(36)
  userId         String    @map("user_id") @db.Char(36)
  actorId        String?   @map("actor_id") @db.Char(36)
  type           NotifType
  postId         String?   @map("post_id") @db.Char(36)
  commentId      String?   @map("comment_id") @db.Char(36)
  announcementId String?   @map("announcement_id") @db.Char(36)
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user         User          @relation("NotifRecipient", fields: [userId], references: [id], onDelete: Restrict)
  actor        User?         @relation("NotifActor", fields: [actorId], references: [id], onDelete: SetNull)
  post         Post?         @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment      Comment?      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@index([announcementId])
  @@map("notifications")
}

model Report {
  id         String           @id @default(uuid()) @db.Char(36)
  reporterId String           @map("reporter_id") @db.Char(36)
  targetType ReportTargetType @map("target_type")
  targetId   String           @map("target_id") @db.Char(36)
  reason     ReportReason
  note       String?          @db.Text
  status     ReportStatus     @default(PENDING)
  handledBy  String?          @map("handled_by") @db.Char(36)
  handledAt  DateTime?        @map("handled_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  reporter User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  handler  User? @relation("ReportHandler", fields: [handledBy], references: [id], onDelete: Restrict)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  adminId    String   @map("admin_id") @db.Char(36)
  action     String   @db.VarChar(60)
  targetType String?  @map("target_type") @db.VarChar(30)
  targetId   String?  @map("target_id") @db.Char(36)
  detail     Json?
  ip         String?  @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  admin User @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  key       String   @id @db.VarChar(60)
  value     Json
  updatedBy String?  @map("updated_by") @db.Char(36)
  updatedAt DateTime @updatedAt @map("updated_at")

  updater User? @relation("SettingUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("settings")
}

model Announcement {
  id        String   @id @default(uuid()) @db.Char(36)
  title     String   @db.VarChar(120)
  body      String   @db.Text
  createdBy String   @map("created_by") @db.Char(36)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  creator       User           @relation("AnnouncementCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@map("announcements")
}

model BlockedWord {
  id        String   @id @default(uuid()) @db.Char(36)
  word      String   @unique @db.VarChar(60)
  createdBy String   @map("created_by") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  creator User @relation("BlockedWordCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@map("blocked_words")
}

model BotProfile {
  userId      String    @id @map("user_id") @db.Char(36)
  persona     String    @db.Text
  postsPerDay Int       @default(2) @map("posts_per_day")
  active      Boolean   @default(true)
  lastPostAt  DateTime? @map("last_post_at")
  lastTickAt  DateTime? @map("last_tick_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bot_profiles")
}

model Sponsored {
  id        String    @id @default(uuid()) @db.Char(36)
  title     String    @db.VarChar(120)
  body      String    @db.Text
  imageUrl  String?   @map("image_url") @db.VarChar(255)
  linkUrl   String    @map("link_url") @db.VarChar(255)
  active    Boolean   @default(true)
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  createdBy String    @map("created_by") @db.Char(36)
  createdAt DateTime  @default(now()) @map("created_at")

  creator User @relation("SponsoredCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([active, startsAt, endsAt])
  @@map("sponsored")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Album {
  id        String    @id @default(uuid()) @db.Char(36)
  ownerId   String    @map("owner_id") @db.Char(36)
  name      String    @db.VarChar(80)
  privacy   Privacy   @default(FRIENDS)
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  photos    Photo[]

  @@index([ownerId, createdAt])
  @@map("albums")
}

model Photo {
  id        String   @id @default(uuid()) @db.Char(36)
  albumId   String   @map("album_id") @db.Char(36)
  ownerId   String   @map("owner_id") @db.Char(36)
  url       String   @db.VarChar(255)
  caption   String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([albumId, id])
  @@index([albumId, createdAt])
  @@index([ownerId, createdAt])
  @@map("photos")
}

model Group {
  id          String        @id @default(uuid()) @db.Char(36)
  name        String        @db.VarChar(80)
  description String        @db.Text
  privacy     GroupPrivacy  @default(PUBLIC)
  avatarUrl   String?       @map("avatar_url") @db.VarChar(255)
  createdBy   String        @map("created_by") @db.Char(36)
  createdAt   DateTime      @default(now()) @map("created_at")
  creator     User          @relation("GroupCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  members     GroupMember[]
  posts       Post[]

  @@index([privacy, createdAt])
  @@map("groups")
}

model GroupMember {
  groupId  String          @map("group_id") @db.Char(36)
  userId   String          @map("user_id") @db.Char(36)
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime        @default(now()) @map("joined_at")
  group    Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([groupId, userId])
  @@index([userId, joinedAt])
  @@map("group_members")
}

model Event {
  id          String      @id @default(uuid()) @db.Char(36)
  title       String      @db.VarChar(120)
  description String      @db.Text
  location    String      @db.VarChar(120)
  startsAt    DateTime    @map("starts_at")
  createdBy   String      @map("created_by") @db.Char(36)
  createdAt   DateTime    @default(now()) @map("created_at")
  creator     User        @relation("EventCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  rsvps       EventRsvp[]

  @@index([startsAt])
  @@map("events")
}

model EventRsvp {
  eventId   String     @map("event_id") @db.Char(36)
  userId    String     @map("user_id") @db.Char(36)
  status    RsvpStatus @default(MAYBE)
  updatedAt DateTime   @updatedAt @map("updated_at")
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([eventId, userId])
  @@index([userId, updatedAt])
  @@map("event_rsvps")
}

model Note {
  id        String    @id @default(uuid()) @db.Char(36)
  authorId  String    @map("author_id") @db.Char(36)
  title     String    @db.VarChar(120)
  body      String    @db.Text
  privacy   Privacy   @default(FRIENDS)
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")
  author    User      @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([authorId, createdAt])
  @@map("notes")
}

model LifeEvent {
  id         String        @id @default(uuid()) @db.Char(36)
  userId     String        @map("user_id") @db.Char(36)
  kind       LifeEventKind
  title      String        @db.VarChar(120)
  happenedOn DateTime      @map("happened_on") @db.Date
  privacy    Privacy       @default(FRIENDS)
  createdAt  DateTime      @default(now()) @map("created_at")
  user       User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, happenedOn])
  @@map("life_events")
}
