{
  "name": "@retrobook/shared",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./i18n": "./i18n/index.ts",
    "./tokens.css": "./tokens.css"
  },
  "sideEffects": [
    "*.css"
  ]
}
