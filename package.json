{
  "name": "retrobook",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @retrobook/api --filter @retrobook/web --filter @retrobook/admin dev",
    "dev:api": "pnpm --filter @retrobook/api dev",
    "dev:admin": "pnpm --filter @retrobook/admin dev",
    "dev:web": "pnpm --filter @retrobook/web dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "test:e2e": "pnpm --filter @retrobook/db migrate:test && pnpm --filter @retrobook/api exec dotenv -e ../../.env -- sh -c 'DATABASE_URL=$TEST_DATABASE_URL pnpm --dir ../.. exec playwright test --config playwright.config.ts'",
    "perf:read": "node scripts/perf-read.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.65.1",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vue-eslint-parser": "^10.4.2"
  }
}
