# Web atau admin produksi: build Vite lalu sajikan lewat nginx. Pilih aplikasi dengan --build-arg APP=web|admin.
FROM node:22-bookworm-slim AS build
ARG APP=web
RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @retrobook/shared build && pnpm --filter @retrobook/${APP} build

FROM nginx:1.27-alpine
ARG APP=web
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/${APP}/dist /usr/share/nginx/html
EXPOSE 80
