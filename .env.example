# Salin ke .env (jangan di-commit). Nilai di bawah hanya untuk dev lokal.

# --- MySQL untuk Docker Compose (OPSIONAL; default dev memakai MySQL lokal, tanpa Docker) ---
MYSQL_ROOT_PASSWORD=dev-root-password
MYSQL_DATABASE=retrobook
MYSQL_PORT=3306
MYSQL_TEST_DATABASE=retrobook_test
MYSQL_TEST_PORT=3307

# --- API ---
# Default: MySQL lokal (root tanpa password). Buat DB sekali: CREATE DATABASE retrobook; retrobook_test;
# Bila memakai Docker Compose, ganti ke mysql://root:<MYSQL_ROOT_PASSWORD>@localhost:3306/retrobook
DATABASE_URL=mysql://root@localhost:3306/retrobook
TEST_DATABASE_URL=mysql://root@localhost:3306/retrobook_test
API_PORT=3030
UPLOAD_DIR=uploads
# Ganti dengan string acak panjang, mis. `openssl rand -base64 48`.
JWT_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Frontend (Vite) ---
# Kosongkan untuk memakai proxy dev Vite (/api -> API_PORT), tanpa CORS. Isi hanya bila API di host lain.
# VITE_API_URL=http://localhost:3030/api
