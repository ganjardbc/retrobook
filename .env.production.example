# Salin ke .env.production (jangan di-commit) dan isi semua nilai.
MYSQL_ROOT_PASSWORD=ganti-dengan-password-kuat
MYSQL_DATABASE=retrobook
# Wajib acak dan minimal 32 karakter, mis. `openssl rand -base64 48`. API menolak boot bila lemah.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Web dan admin disajikan lewat proxy satu origin, jadi CORS hanya perlu bila ada klien lain.
CORS_ORIGINS=http://localhost:8080,http://localhost:8081
WEB_PORT=8080
ADMIN_PORT=8081
